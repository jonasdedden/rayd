    {
      "id": 5,
      "type": "timeseries",
      "title": "GCS RPC rate",
      "description": "Per-second rate of Register / Heartbeat RPCs and broadcast WatchNodes events. Heartbeats dominate at steady state.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(rayd_gcs_heartbeat_received_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "heartbeats/s"
        },
        {
          "expr": "rate(rayd_gcs_register_node_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "registers/s"
        },
        {
          "expr": "rate(rayd_gcs_watch_events_published_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "C",
          "legendFormat": "watch events/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node-status sweeper outcome",
      "description": "Derived: register events equal alive transitions; watch events \u2265 register because Drain and sweeper-Dead also publish. The gap is the rate of cluster-topology disturbance.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(rayd_gcs_watch_events_published_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval]) - rate(rayd_gcs_register_node_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "drain+dead events/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
