    {
      "id": 10,
      "type": "gauge",
      "title": "NodeIndex fast-path hit ratio",
      "description": "Hit / (hit+miss) for the WatchNodes-driven owner-liveness lookup (Phase 4.3.3c-F). Should be \u2265 99% at steady state; sustained dips suggest the subscriber is missing events or restarting cold.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(rayd_node_index_status_lookups_total{outcome=\"hit\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(rayd_node_index_status_lookups_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "refId": "A",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
