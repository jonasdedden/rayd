      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(rayd_driver_tasks_submitted_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "submitted/s"
        },
        {
          "expr": "rate(rayd_driver_tasks_completed_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "completed/s"
        },
        {
          "expr": "rate(rayd_driver_tasks_failed_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "C",
          "legendFormat": "failed/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "rayd.put / rayd.get / sec",
      "description": "Driver-side put/get call rate. get includes both rayd.get and rayd.get_settled.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(rayd_driver_puts_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "puts/s"
        },
        {
          "expr": "rate(rayd_driver_gets_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "gets/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Live ObjectRefs",
      "description": "rayd_driver_refs_alive \u2014 distinct ObjectIds the local RefCounter currently tracks (any kind of pin: local, borrower, submit-dep). Read at scrape time from the live counter.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rayd_driver_refs_alive{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "alive"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Task failure ratio",
      "description": "failed / (completed + failed). Sustained > 0 means tasks are crashing \u2014 drill into rayd-py logs.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(rayd_driver_tasks_failed_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(rayd_driver_tasks_completed_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])) + sum(rate(rayd_driver_tasks_failed_total{rayd_cluster=~\"$rayd_cluster\",instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "refId": "A",
          "legendFormat": "failure ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
